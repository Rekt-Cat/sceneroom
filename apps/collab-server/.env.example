# Template for the collab server's settings. Copy to `.env` in this folder and fill in real values.
# NEVER put real secrets in this file: it is committed to a public repository.

# Port and address to listen on
PORT=1234
HOST=127.0.0.1

# Where the SQLite database file lives (the folder is created if missing)
DB_PATH=./data/collab.sqlite

# Link tokens are signed with this. At least 32 characters. Make your own, for example:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COLLAB_SECRET=replace-me-with-a-long-random-string-0000

# Optional limits (bytes). Defaults: 1 MiB per message, 20 MiB per saved document
# MAX_MESSAGE_BYTES=1048576
# MAX_DOCUMENT_BYTES=20971520

# Big files (models, meshes, pictures) go through /files/... on the same port
# FILES_DIR=./data/files
# MAX_FILE_BYTES=52428800
# MAX_PROJECT_FILE_BYTES=524288000
# Web addresses (comma separated) that may call the file routes from the browser
# ALLOWED_ORIGINS=http://localhost:3000

# Keep the shared documents in Postgres instead of the SQLite file (step M8f). Run the migrations first:
#   pnpm --filter @sceneroom/db migrate:deploy
# and copy the documents you already have, once:  pnpm --filter @sceneroom/collab-server migrate-documents
# DATABASE_URL=postgresql://sceneroom:sceneroom@127.0.0.1:5432/sceneroom

# --- Production on a host whose disk does not last (a free web service), see docs/backend/DEPLOYMENT.md ---
# Big files in an S3-compatible bucket (Cloudflare R2, Backblaze B2, AWS S3). All four go together; none = a folder (FILES_DIR).
# Try them with: pnpm --filter @sceneroom/collab-server check-files
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=sceneroom-files
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# The share-link routes keep their owners in the SQLite file, which such a host loses at every restart: switch them off.
# LINK_SHARING=false

